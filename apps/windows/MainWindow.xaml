<Window
    x:Class="Photosink.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Photosink"
    Title="Photosink">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Photosink" IsBackButtonVisible="False" IsPaneToggleButtonVisible="True" />

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="220"
            PaneDisplayMode="Left">
            <Grid x:Name="Pages">
                <local:SettingsPage x:Name="SettingsView" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
