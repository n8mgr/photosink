<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Photosink</RootNamespace>
    <AssemblyName>Photosink</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <ApplicationIcon>photosink.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</RepoRoot>
    <BridgeTriple Condition="'$(BridgeTriple)' == '' and '$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</BridgeTriple>
    <BridgeTriple Condition="'$(BridgeTriple)' == ''">x86_64-pc-windows-msvc</BridgeTriple>
    <BridgeDll>$(RepoRoot)target\$(BridgeTriple)\release\photosink_bridge.dll</BridgeDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(BridgeDll)" Link="photosink_bridge.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="PublishXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <XamlResource Include="$(OutDir)**\*.pri;$(OutDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(XamlResource)" DestinationFiles="@(XamlResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RequireBridge" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)Generated\photosink_bridge.cs')" Text="Generated\photosink_bridge.cs is missing. Run cargo xtask build from the repository root, which builds the bridge and generates the bindings." />
    <Error Condition="!Exists('$(BridgeDll)')" Text="$(BridgeDll) is missing. Run cargo xtask build --target $(BridgeTriple) from the repository root, or cargo build --release -p photosink-bridge --target $(BridgeTriple)." />
  </Target>
</Project>
